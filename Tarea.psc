Algoritmo Tarea
	Definir nombre, fechaNaci, correo, id, edad, telefono Como Caracter
	
	Escribir "Escriba su identificacion:"
	Leer id
	Escribir "Escriba su nombre completo:"
	Leer nombre
	Escribir "Escriba su edad:"
	Leer edad
	Escribir "Escriba su fecha de nacimiento:"
	Leer fechaNaci
	Escribir "Escriba su correo:"
	Leer correo
	Escribir "Escriba su telefono:"
	Leer telefono
	
	Escribir "DETALLES DE SUS DATOS"
	Imprimir "Identificacion: ", id
	Imprimir "Nombre: ", nombre
	Imprimir "Edad: ", edad
	Imprimir "Fecha de nacimiento: ", fechaNaci
	Imprimir "Correo: ", correo
	Imprimir "Telefono: ", telefono
	
FinAlgoritmo
